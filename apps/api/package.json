{
  "name": "@fonology/api",
  "private": true,
  "version": "0.1.0",
  "description": "Fonology — backend API. The only service holding a database or storage credential; enforces permissions server-side.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "eslint . --ext .ts,.mjs --max-warnings 0",
    "db:types": "pnpm --package=kysely-codegen@0.20.0 --package=kysely@0.29.6 --package=pg@8 --package=typescript@5 dlx kysely-codegen --config-file .kysely-codegenrc.json && prettier --write src/db/types.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "storage:setup": "tsx src/scripts/storage-setup.ts",
    "purge:documents": "tsx src/scripts/purge-documents.ts",
    "purge:print-jobs": "tsx src/scripts/purge-print-jobs.ts",
    "import:supabase": "tsx src/scripts/import-from-supabase.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@node-rs/argon2": "^2.2.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "kysely": "^0.29.6",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "stripe": "^22.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
