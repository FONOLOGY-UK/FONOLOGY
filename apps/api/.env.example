# ============================================================================
# Fonology — apps/api environment
# Copy to `.env.local` for local dev. NEVER commit real secrets — this file
# ships with empty placeholders only. Populate .env.local yourself; it's
# gitignored (see root .gitignore).
#
# Deployment: Infisical is the source of truth in production — Coolify pulls
# these same variable names from Infisical and injects them as real env vars.
# Nothing in this app should read process.env directly outside src/config.ts;
# that's the one place that needs to change (never) when the source of env
# values changes from .env.local to Infisical-injected.
# ============================================================================

# ----------------------------------------------------------------------------
# SUPABASE — dev project only. Never point this at the production project
# (sbqqpuqoizyjzdcydqid) from a local/dev environment.
# ----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key — bypasses RLS entirely. Server-side only, never sent to
# the browser, never in any client bundle. Guard this like a database password.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------------------
PORT=4000
# Comma-separated list of origins allowed to send credentialed requests
# (the storefront + admin/POS origin(s) in each environment).
CORS_ORIGINS=http://localhost:3000
