# ============================================================================
# Fonology — apps/web environment
# Copy to `.env.local` for local dev. NEVER commit real secrets.
# All build-time-public vars are prefixed NEXT_PUBLIC_ (exposed to the browser).
# ============================================================================

# ----------------------------------------------------------------------------
# API BASE URL
# Base URL the web app calls, e.g. https://api.fonology.co.uk. Locally
# http://localhost:4000 — never 127.0.0.1 (different origin; breaks the cookie).
# ----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=

# ----------------------------------------------------------------------------
# SITE URL
# Canonical public origin, used for absolute URLs / metadata / sitemaps.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# SUPABASE — only to allow product images from its Storage in next.config.mjs,
# until they move to Garage. Public by design. Dev project only.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=

# ----------------------------------------------------------------------------
# RUNTIME (set by the container / Coolify; sensible defaults below)
# ----------------------------------------------------------------------------
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0

# ---------------------------------------------------------------------------
# Stripe — online card payment (publishable key ONLY)
# ---------------------------------------------------------------------------
# Safe to expose: this is the key Stripe intends to ship to browsers, and it
# can do nothing on its own. THE SECRET KEY MUST NEVER APPEAR IN THIS FILE —
# anything prefixed NEXT_PUBLIC_ is compiled into the client bundle and served
# to every visitor.
#
# Leave it unset and the checkout renders a clearly-labelled "no payment
# provider configured" state instead of a card form, which is what mock mode
# and a fresh dev machine get.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
