# ============================================================================
# Fonology — apps/api environment
# Copy to `.env.local` for local dev. NEVER commit real secrets — this file
# ships with empty placeholders only. Populate .env.local yourself; it's
# gitignored (see root .gitignore).
#
# Deployment: Infisical is the source of truth in production — Coolify pulls
# these same variable names from Infisical and injects them as real env vars.
# Nothing in this app should read process.env directly outside src/config.ts;
# that's the one place that needs to change (never) when the source of env
# values changes from .env.local to Infisical-injected.
# ============================================================================

# ----------------------------------------------------------------------------
# STORAGE — S3-compatible (Garage). Buckets are made by `pnpm storage:setup`.
# Local stack: endpoint http://localhost:3900, the dev key from
# scripts/dev-stack.mjs (DEV_KEY_ID / DEV_KEY_SECRET), photos on :3902.
# The secret key is server-side only — guard it like a database password.
# ----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:3900
# S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Where a browser reaches the S3 API for signed links to private files, when
# that differs from S3_ENDPOINT (the API talking to storage privately).
# S3_PUBLIC_ENDPOINT=
# Public base URL of the product-images bucket.
STORAGE_PUBLIC_URL=http://localhost:3902

# ----------------------------------------------------------------------------
# DATABASE — Postgres as the fonology_api role (created by `pnpm db:migrate`).
# Local stack (`pnpm stack:up`): postgres://fonology_api:fonology_api@localhost:55432/fonology
# ----------------------------------------------------------------------------
DATABASE_URL=
# DATABASE_POOL_MAX=10

# ----------------------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------------------
PORT=4000
# Which deployment this is: production (the live shop) or development.
# REQUIRED when NODE_ENV=production (the API image sets that) — the API and
# its scripts refuse to start without it there.
APP_ENV=development
# Pre-launch testing on the live server only: lets e2e/seed/cleanup write test
# data to production and lets the API run with a Stripe TEST key. Remove on
# opening day.
# ALLOW_TEST_WRITES=true
# Comma-separated list of origins allowed to send credentialed requests
# (the storefront + admin/POS origin(s) in each environment).
CORS_ORIGINS=http://localhost:3000
# The customer-facing origin — used to build links that go INTO emails
# (e.g. the trade-in acceptance link). Must match where the storefront
# actually runs.
WEB_APP_URL=http://localhost:3000
# Reverse proxies in front of this API: 1 = Coolify/Traefik alone (default), 2 = Cloudflare in front too.
# Too high lets visitors forge X-Forwarded-For and dodge the login rate limit.
# TRUST_PROXY_HOPS=1

# Where browsers reach this API. Google sends visitors back to
# ${API_PUBLIC_URL}/auth/google/callback — add that exact URL to the OAuth
# client's authorised redirect URIs.
API_PUBLIC_URL=http://localhost:4000

# ----------------------------------------------------------------------------
# GOOGLE SIGN-IN — optional. Without both, the storefront says Google isn't
# available and offers email instead. Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID (Web application).
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# SMTP — when set, every email goes out over SMTP instead of Brevo's API.
# Local stack: smtp://localhost:1025 (Mailpit — read them at http://localhost:8025).
# ----------------------------------------------------------------------------
SMTP_URL=

# ----------------------------------------------------------------------------
# BREVO — transactional email. Optional: leave BREVO_API_KEY unset and the
# app still runs; emails that would have gone out are logged and skipped
# instead of sent (see lib/email.ts). Get the real key from Infisical, same
# as every other secret here — never paste it into chat.
# ----------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@fonology.co.uk
BREVO_SENDER_NAME=Fonology

# ----------------------------------------------------------------------------
# SMS — repair-stage texts (0105). log = write them to the console and the
# job's SMS log only (default; nothing reaches a phone). brevo = send through
# Brevo with BREVO_API_KEY (needs SMS credits on the Brevo account). off = none.
# ----------------------------------------------------------------------------
SMS_MODE=log
BREVO_SMS_SENDER=Fonology

# ----------------------------------------------------------------------------
# SCHEMA AUDIT — scripts/schema-audit.ts signs in as a real staff account to
# audit the staff-only endpoints. These were hardcoded in the script until it
# was pointed out that credentials-in-git is the same habit that once put a
# service-role key in a web env file.
#
# Dev accounts only — never a production login. The script exits with a clear
# message if either is missing; there is deliberately no fallback, because a
# default would let the audit appear to run while silently authenticating as
# the wrong user.
# ----------------------------------------------------------------------------
AUDIT_STAFF_EMAIL=
AUDIT_STAFF_PASSWORD=

# ---------------------------------------------------------------------------
# Stripe — online card payment
# ---------------------------------------------------------------------------
# BOTH ARE OPTIONAL. The API boots without them; only online card payment is
# unavailable (the checkout says so plainly and the till is unaffected).
#
# Get these from the Stripe Dashboard for the account you are pointing at:
#   Secret key      Developers > API keys        (starts sk_test_ / sk_live_)
#   Webhook secret  Developers > Webhooks        (starts whsec_)
#
# The webhook secret is per-endpoint. `stripe listen` prints its OWN whsec_
# for local forwarding, which is a DIFFERENT value from the one shown against
# a deployed endpoint in the dashboard — using the dashboard's value locally
# is the single most common reason signature verification fails.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
