# Hoist nothing by default; keep node_modules deterministic for the monorepo.
# shamefully-hoist is intentionally OFF so we catch missing peer deps early.
auto-install-peers=true
strict-peer-dependencies=false
# Next.js + its transitive deps expect these to be resolvable at the app root.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
