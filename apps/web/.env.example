# ============================================================================
# Fonology — apps/web environment
# Copy to `.env.local` for local dev. NEVER commit real secrets.
# All build-time-public vars are prefixed NEXT_PUBLIC_ (exposed to the browser).
# ============================================================================

# ----------------------------------------------------------------------------
# DATA SOURCE
# Which DataAdapter the app uses. `mock` runs the whole app with in-memory
# fixtures and needs no backend. `http` switches to the real API (Raja) — see
# INTEGRATION.md. This is the single switch; no component changes are needed.
#   mock | http
# ----------------------------------------------------------------------------
NEXT_PUBLIC_DATA_SOURCE=mock

# ----------------------------------------------------------------------------
# API BASE URL
# Base URL the http adapter calls, e.g. https://api.fonology.co.uk. Only used
# when NEXT_PUBLIC_DATA_SOURCE=http. Leave blank for mock mode.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=

# ----------------------------------------------------------------------------
# SITE URL
# Canonical public origin, used for absolute URLs / metadata / sitemaps.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# SUPABASE (browser client — Google sign-in)
# Used by supabase-js in the browser to drive the OAuth redirect. Both values
# here are public by design (safe to ship in the client bundle) — this is
# NOT the service-role key, which never belongs in this app. Dev project only.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# RUNTIME (set by the container / Coolify; sensible defaults below)
# ----------------------------------------------------------------------------
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0
